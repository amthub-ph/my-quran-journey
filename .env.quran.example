# Add to .env.local alongside your existing Supabase settings. Never use NEXT_PUBLIC for these.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# Use matching approved credentials. Prelive covers only surahs 1 and 2.
QF_ENV=prelive
# Defaults are validated against Quran Foundation’s resource catalog at runtime.
QF_TRANSLATION_ID=20
QF_RECITATION_ID=7
